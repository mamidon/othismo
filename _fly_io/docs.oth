# What we ship to fly.io: the project's documentation, served over HTTP.
#
# The Dockerfile next to this lays out a build directory around it:
#
#   docs.oth            this file
#   scripts/*.wasm      HttpServer and StaticSite, compiled from examples/static/scripts
#   public/             the site, with docs/*.md freshly rendered to HTML
#
# and seals it into docs.rti. Fly's proxy terminates TLS and forwards plain
# HTTP to port 8080 (internal_port in the root fly.toml), so that is where we listen.

# The objects come from their modules, whose headers are inside them.
import { HttpServer } from "./scripts/HttpServer.wasm"
import { StaticSite } from "./scripts/StaticSite.wasm"
import { Console, Listener, PackedFiles } from env

require listen : text/plain = "0.0.0.0:8080"

# All it takes from the host: the socket, and the access log, which
# `fly logs` shows.
needs /net/tcp  Listener
needs /dev/cons Console

# HTTP in, namespace requests out. Every host name is served the site.
instance http : HttpServer {
  bind  /net/tcp  /net/tcp
  bind  /dev/cons /dev/cons
  mount /www site
}

# The site can read the files and nothing else.
instance site : StaticSite {
  mount /files files readonly
}

instance files : PackedFiles { include "./public/" }

mount /http http

write /net/tcp listen
write /http/hosts/* "/www"
