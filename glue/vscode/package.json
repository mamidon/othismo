{
  "name": "glue",
  "displayName": "Glue",
  "description": "Language support for Glue",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:glue",
    "onView:glueSyntaxTree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "glue",
        "aliases": [
          "Glue"
        ],
        "extensions": [
          ".glue"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "enabled": true
      }
    },
    "views": {
      "explorer": [
        {
          "id": "glueSyntaxTree",
          "name": "Glue Syntax Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "glueSyntaxTree",
        "contents": "Open a .glue file to see its syntax tree.\n\nThe tree follows the active editor: click a node to select its source range, or move the cursor to reveal the innermost node containing it."
      }
    ],
    "commands": [
      {
        "command": "glue.revealNode",
        "title": "Reveal Node in Editor",
        "category": "Glue"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "glue.revealNode",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Glue",
      "properties": {
        "glue.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the glue language server binary. Defaults to target/debug/lsp in the othismo checkout."
        },
        "glue.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic between VS Code and the server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.3.0"
  }
}
