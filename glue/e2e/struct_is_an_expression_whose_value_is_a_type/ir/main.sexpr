(struct Pixel
  (field on bool))

(global @lit Pixel)

(func <file> () -> bool
  (slot 0 t0 Pixel temp)
  (slot 1 t1 Pixel temp)
  (slot 2 t2 bool temp)
  (block 0
    (assign t0 (struct (const true)))
    (store @lit t0)
    (assign t1 (globalget @lit))
    (assign t2 (field t1 on))
    (return t2)))   ; the file's top level (§statements)
