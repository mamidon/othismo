(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t0 (call clamp (const 99u64) (const 10u64)))
    (assign t1 (call clamp (const 3u64) (const 10u64)))
    (assign t2 (add t0 t1))
    (return t2)))   ; the file's top level (§statements)

(func clamp (u64 u64) -> u64
  (slot 0 n     u64 param)
  (slot 1 limit u64 param)
  (slot 2 t2    bool temp)
  (block 0
    (assign t2 (gt n limit))
    (if t2
      (then 1
        (return limit))
      (else 2))
    (return n)))
