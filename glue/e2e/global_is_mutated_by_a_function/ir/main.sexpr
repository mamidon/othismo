(global @counter u64 mut)

(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (block 0
    (store @counter (const 0u64))
    (drop (call bump))
    (drop (call bump))
    (assign t0 (globalget @counter))
    (return t0)))   ; the file's top level (§statements)

(func bump ()
  (slot 0 t0 u64 temp)
  (slot 1 t1 u64 temp)
  (block 0
    (assign t0 (globalget @counter))
    (assign t1 (add t0 (const 1u64)))
    (store @counter t1)
    (return (const ()))))
