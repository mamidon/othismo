(global @base u64)
(global @add_base (fn (u64) -> u64))

(func <file> () -> u64
  (slot 0 t0 (fn (u64) -> u64) temp)
  (slot 1 t1 (fn (u64) -> u64) temp)
  (slot 2 t2 u64 temp)
  (block 0
    (store @base (const 10u64))
    (assign t0 (closure <file>.λ0))
    (store @add_base t0)
    (assign t1 (globalget @add_base))
    (assign t2 (call-indirect t1 (const 32u64)))
    (return t2)))   ; the file's top level (§statements)

(func <file>.λ0 (u64) -> u64
  (slot 0 n  u64 param)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t1 (globalget @base))
    (assign t2 (add n t1))
    (return t2)))
