(struct Counter
  (field hits u64))

(global @c Counter mut)
(global @alias Counter mut)

(func <file> () -> u64
  (slot 0 t0 Counter temp)
  (slot 1 t1 Counter temp)
  (slot 2 t2 Counter temp)
  (slot 3 t3 Counter temp)
  (slot 4 t4 Counter temp)
  (slot 5 t5 u64 temp)
  (block 0
    (assign t0 (struct (const 0u64)))
    (store @c t0)
    (assign t1 (globalget @c))
    (store @alias t1)
    (assign t2 (globalget @c))
    (drop (call bump t2))
    (assign t3 (globalget @alias))
    (drop (call bump t3))
    (assign t4 (globalget @c))
    (assign t5 (field t4 hits))
    (return t5)))   ; the file's top level (§statements)

(func bump (Counter)
  (slot 0 c  Counter param mut)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t1 (field c hits))
    (assign t2 (add t1 (const 1u64)))
    (store (field c hits) t2)
    (return (const ()))))
