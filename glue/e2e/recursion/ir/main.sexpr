(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (block 0
    (assign t0 (call fib (const 10u64)))
    (return t0)))   ; the file's top level (§statements)

(func fib (u64) -> u64
  (slot 0 n  u64 param)
  (slot 1 t1 bool temp)
  (slot 2 t2 u64 temp)
  (slot 3 t3 u64 temp)
  (slot 4 t4 u64 temp)
  (slot 5 t5 u64 temp)
  (slot 6 t6 u64 temp)
  (block 0
    (assign t1 (lt n (const 2u64)))
    (if t1
      (then 1
        (assign t6 n))
      (else 2
        (assign t2 (sub n (const 1u64)))
        (assign t3 (call fib t2))
        (assign t4 (sub n (const 2u64)))
        (assign t5 (call fib t4))
        (assign t6 (add t3 t5))))
    (return t6)))
