(struct C
  (field hits u64))

(global @c C)

(func <file> () -> u64
  (slot 0 t0 C temp)
  (slot 1 t1 C temp)
  (slot 2 t2 C temp)
  (slot 3 t3 u64 temp)
  (block 0
    (assign t0 (struct (const 0u64)))
    (store @c t0)
    (assign t1 (globalget @c))
    (drop (call bump t1))
    (assign t2 (globalget @c))
    (assign t3 (field t2 hits))
    (return t3)))   ; the file's top level (§statements)

(func bump (C)
  (slot 0 c  C param mut)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t1 (field c hits))
    (assign t2 (add t1 (const 1u64)))
    (store (field c hits) t2)
    (return (const ()))))
