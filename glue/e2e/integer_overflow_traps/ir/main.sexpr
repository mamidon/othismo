(func <file> () -> u8
  (slot 0 t0 u8 temp)
  (block 0
    (assign t0 (call add (const 255u8) (const 1u8)))
    (return t0)))   ; the file's top level (§statements)

(func add (u8 u8) -> u8
  (slot 0 a  u8 param)
  (slot 1 b  u8 param)
  (slot 2 t2 u8 temp)
  (block 0
    (assign t2 (add a b))
    (return t2)))
