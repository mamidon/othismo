(global @byte u8)
(global @wide u32)
(global @signed s16)
(global @hex u8)

(func <file> () -> u64
  (slot 0 t0  u8 temp)
  (slot 1 t1  u64 temp)
  (slot 2 t2  u32 temp)
  (slot 3 t3  u64 temp)
  (slot 4 t4  u64 temp)
  (slot 5 t5  s16 temp)
  (slot 6 t6  u64 temp)
  (slot 7 t7  u64 temp)
  (slot 8 t8  u8 temp)
  (slot 9 t9  u64 temp)
  (slot 10 t10 u64 temp)
  (block 0
    (store @byte (const 1u8))
    (store @wide (const 1000u32))
    (store @signed (const 7s16))
    (store @hex (const 255u8))
    (assign t0 (globalget @byte))
    (assign t1 (cast t0))
    (assign t2 (globalget @wide))
    (assign t3 (cast t2))
    (assign t4 (add t1 t3))
    (assign t5 (globalget @signed))
    (assign t6 (cast t5))
    (assign t7 (add t4 t6))
    (assign t8 (globalget @hex))
    (assign t9 (cast t8))
    (assign t10 (add t7 t9))
    (return t10)))   ; the file's top level (§statements)
