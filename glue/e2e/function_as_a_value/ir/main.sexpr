(global @f (fn (u64) -> u64))

(func <file> () -> u64
  (slot 0 t0 (fn (u64) -> u64) temp)
  (slot 1 t1 (fn (u64) -> u64) temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t0 (closure double))
    (store @f t0)
    (assign t1 (globalget @f))
    (assign t2 (call-indirect t1 (const 21u64)))
    (return t2)))   ; the file's top level (§statements)

(func double (u64) -> u64
  (slot 0 n  u64 param)
  (slot 1 t1 u64 temp)
  (block 0
    (assign t1 (mul n (const 2u64)))
    (return t1)))
