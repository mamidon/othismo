(global @x.0 u64)
(global @x.1 u64)
(global @x.2 u64)

(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (slot 3 t3 u64 temp)
  (slot 4 t4 u64 temp)
  (block 0
    (store @x.0 (const 1u64))
    (assign t0 (globalget @x.0))
    (assign t1 (add t0 (const 1u64)))
    (store @x.1 t1)
    (assign t2 (globalget @x.1))
    (assign t3 (mul t2 (const 10u64)))
    (store @x.2 t3)
    (assign t4 (globalget @x.2))
    (return t4)))   ; the file's top level (§statements)
