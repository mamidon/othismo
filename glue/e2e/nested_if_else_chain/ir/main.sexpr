(func <file> () -> Str
  (slot 0 t0 Str temp)
  (block 0
    (assign t0 (call describe (const 42u64)))
    (return t0)))   ; the file's top level (§statements)

(func describe (u64) -> Str
  (slot 0 n  u64 param)
  (slot 1 t1 bool temp)
  (slot 2 t2 bool temp)
  (slot 3 t3 Str temp)
  (slot 4 t4 Str temp)
  (block 0
    (assign t1 (eq n (const 0u64)))
    (if t1
      (then 1
        (assign t4 (const "zero")))
      (else 2
        (assign t2 (lt n (const 10u64)))
        (if t2
          (then 3
            (assign t3 (const "small")))
          (else 4
            (assign t3 (const "large"))))
        (assign t4 t3)))
    (return t4)))
