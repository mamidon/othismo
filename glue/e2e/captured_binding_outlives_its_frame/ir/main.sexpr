(global @next (fn () -> u64))

(func <file> () -> u64
  (slot 0 t0 (fn () -> u64) temp)
  (slot 1 t1 (fn () -> u64) temp)
  (slot 2 t2 u64 temp)
  (slot 3 t3 (fn () -> u64) temp)
  (slot 4 t4 u64 temp)
  (slot 5 t5 u64 temp)
  (slot 6 t6 (fn () -> u64) temp)
  (slot 7 t7 u64 temp)
  (slot 8 t8 u64 temp)
  (block 0
    (assign t0 (call make))
    (store @next t0)
    (assign t1 (globalget @next))
    (assign t2 (call-indirect t1))
    (assign t3 (globalget @next))
    (assign t4 (call-indirect t3))
    (assign t5 (add t2 t4))
    (assign t6 (globalget @next))
    (assign t7 (call-indirect t6))
    (assign t8 (add t5 t7))
    (return t8)))   ; the file's top level (§statements)

(func make () -> (fn () -> u64)
  (slot 0 count (cell u64) local mut)
  (slot 1 t1    (fn () -> u64) temp)
  (block 0
    (assign count (makecell (const 0u64)))
    (assign t1 (closure make.λ0 (captures count)))
    (return t1)))

(func make.λ0 () -> u64
  (slot 0 count (cell u64) capture mut)
  (slot 1 t1    u64 temp)
  (slot 2 t2    u64 temp)
  (slot 3 t3    u64 temp)
  (block 0
    (assign t1 (cellget count))
    (assign t2 (add t1 (const 1u64)))
    (store (cell count) t2)
    (assign t3 (cellget count))
    (return t3)))
