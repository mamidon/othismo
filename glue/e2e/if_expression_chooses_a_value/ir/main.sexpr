(global @n u64)

(func <file> () -> Str
  (slot 0 t0 u64 temp)
  (slot 1 t1 u64 temp)
  (slot 2 t2 bool temp)
  (slot 3 t3 Str temp)
  (block 0
    (store @n (const 7u64))
    (assign t0 (globalget @n))
    (assign t1 (rem t0 (const 2u64)))
    (assign t2 (eq t1 (const 0u64)))
    (if t2
      (then 1
        (assign t3 (const "even")))
      (else 2
        (assign t3 (const "odd"))))
    (return t3)))   ; the file's top level (§statements)
