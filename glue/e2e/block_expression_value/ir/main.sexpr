(global @v u64)

(func <file> () -> u64
  (slot 0 a  u64 local)
  (slot 1 b  u64 local)
  (slot 2 t2 u64 temp)
  (slot 3 t3 u64 temp)
  (block 0
    (assign a (const 2u64))
    (assign b (const 3u64))
    (assign t2 (mul a b))
    (store @v t2)
    (assign t3 (globalget @v))
    (return t3)))   ; the file's top level (§statements)
