(global @a u64)
(global @b u64)

(func <file> () -> bool
  (slot 0 t0 bool temp)
  (slot 1 t1 bool temp)
  (slot 2 t2 u64 temp)
  (slot 3 t3 u64 temp)
  (slot 4 t4 u64 temp)
  (slot 5 t5 u64 temp)
  (slot 6 t6 u64 temp)
  (slot 7 t7 u64 temp)
  (block 0
    (store @a (const 3u64))
    (store @b (const 4u64))
    (assign t2 (globalget @a))
    (assign t3 (globalget @b))
    (assign t1 (lt t2 t3))
    (if t1
      (then 1
        (assign t4 (globalget @b))
        (assign t5 (globalget @a))
        (assign t1 (ge t4 t5)))
      (else 2))
    (assign t0 t1)
    (if t0
      (then 3
        (assign t6 (globalget @a))
        (assign t7 (globalget @b))
        (assign t0 (ne t6 t7)))
      (else 4))
    (return t0)))   ; the file's top level (§statements)
