(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (block 0
    (assign t0 (call forever (const 0u64)))
    (return t0)))   ; the file's top level (§statements)

(func forever (u64) -> u64
  (slot 0 n  u64 param)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (block 0
    (assign t1 (add n (const 1u64)))
    (assign t2 (call forever t1))
    (return t2)))
