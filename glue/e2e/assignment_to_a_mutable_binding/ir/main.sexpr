(global @total u64 mut)

(func <file> () -> u64
  (slot 0 t0 u64 temp)
  (slot 1 t1 u64 temp)
  (slot 2 t2 u64 temp)
  (slot 3 t3 u64 temp)
  (slot 4 t4 u64 temp)
  (block 0
    (store @total (const 0u64))
    (assign t0 (globalget @total))
    (assign t1 (add t0 (const 5u64)))
    (store @total t1)
    (assign t2 (globalget @total))
    (assign t3 (mul t2 (const 2u64)))
    (store @total t3)
    (assign t4 (globalget @total))
    (return t4)))   ; the file's top level (§statements)
