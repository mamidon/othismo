(global @i u64 mut)
(global @last u64 mut)

(func <file> () -> u64
  (slot 0 t0      u64 temp)
  (slot 1 t1      bool temp)
  (slot 2 t2      u64 temp)
  (slot 3 doubled u64 local)
  (slot 4 t4      u64 temp)
  (slot 5 t5      u64 temp)
  (slot 6 t6      u64 temp)
  (block 0
    (store @i (const 0u64))
    (store @last (const 0u64))
    (while
      (header 1
        (assign t0 (globalget @i))
        (assign t1 (lt t0 (const 3u64))))
      (cond t1)
      (body 2
        (assign t2 (globalget @i))
        (assign doubled (mul t2 (const 2u64)))
        (store @last doubled)
        (assign t4 (globalget @i))
        (assign t5 (add t4 (const 1u64)))
        (store @i t5)))
    (assign t6 (globalget @last))
    (return t6)))   ; the file's top level (§statements)
