// §lexical — every literal the lexer produces, and every form of comment.
//
// The files in this directory are a regression suite: the parser's
// `the_examples_parse_cleanly` test asserts that each one lexes and parses
// without a single diagnostic and comes back out of the tree byte for byte.
//
// The token set is a deliberately small core. Absent here, and meant to come
// back when there is a reason for them: raw and multiline strings, doc
// comments, bitwise and shift operators, compound assignment, `::`, and `..`.

// ---- Integers -------------------------------------------------------------

let decimal = 42;
let separated = 1_000_000;
let hex = 0xff;
let octal = 0o17;
let binary = 0b1010;

// A radix literal's digits and its suffix are told apart by the digit set, so
// `0x1f32` is one number where `0x1u8` is a number with a suffix.
let hex_run = 0x1f32;
let hex_suffixed = 0x1u8;

let unsigned = 1_000u32;
let signed = 7s16;
// An integer may carry a float suffix.
let widened = 1f64;

// ---- Floats ---------------------------------------------------------------

let simple = 1.5;
// §lexical: a leading `.` begins a float when the preceding significant token
// could not end an expression. Here that token is `=`.
let leading_dot = .5;
let exponent = 1e10;
let float_suffix = 1.0f32;

// ---- Text -----------------------------------------------------------------
// One string form. It takes escapes and stops at a newline, so a missing quote
// costs one line rather than the rest of the file.

let string = "hello";
let escapes = "newline \n tab \t null \0 quote \" backslash \\ apostrophe \'";
let unicode = "grinning face: \u{1F600}";

let character = 'x';
let char_escape = '\n';
let char_unicode = '\u{263A}';

// ---- Booleans -------------------------------------------------------------
// §lexical has no `nil`, so these are the only two, and §expressions has no
// truthiness — a condition may be nothing else.

let yes = true;
let no = false;

// ---- Unit -----------------------------------------------------------------
// One value, one inhabitant. A real value, not an absence (§functions).

let nothing = ();

// ---- Comments -------------------------------------------------------------
// Both forms are trivia. There is no doc comment in the core, so a `///` is a
// line comment like any other and a row of slashes is just a divider.

// A line comment.

/// Three slashes, and still only a comment.

/// / -------------------------------------------------------------------------

/* A block comment. /* They nest. */ Still inside the outer one. */

type Marker = u64;

// A file may end in an expression with no `;`, which is the file's value
// (§statements).
decimal
