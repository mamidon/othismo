// §expressions — every expression form, and the whole precedence ladder.
//
// Background tint runs by nesting depth — deeper is darker, so the shape on
// screen is the shape of the tree. Text colour cycles per token, so you can
// see where one token ends and the next begins. The Glue Syntax Tree panel in
// the Explorer follows the cursor.

// ---- What the expressions below are written against -----------------------
// Every expression needs something to name. §modules has no answer yet for how
// a program reaches its host, so the functions here compute and do nothing
// else. Declarations are hoisted within their block (§functions, §scope), so
// the structs at the bottom of the file are in scope up here.

fn f(a: u64, b: u64) -> u64 { a + b }
fn nothing_at_all() { }
fn work() { }
fn lookup(id: u64) -> Row { Row { result: "first" } }

let ok = true;
let ready = false;
let n = 5u64;
let items = "abcd";
let counter = 0u64;
let point = Point { x: 1, y: 2 };

// ---- Primary --------------------------------------------------------------

let literal = 42;
let name = literal;
// `( … )` groups and nothing else — it does not change a value's type,
// meaning, or evaluation (§expressions).
let grouped = (1 + 2) * 3;
// `()` is the unit value, not an empty grouping.
let unit = ();

// ---- Prefix ---------------------------------------------------------------
// Two of them. Unary `-` is defined on signed and float types only; negating
// an unsigned value is a type error, not a runtime trap (§expressions). There
// is no `~`, because the core has no bitwise operators to complement with.

let negated = -1;
let inverted = !true;
let stacked = --1;

// ---- Arithmetic -----------------------------------------------------------

let sum = 1 + 2;
let difference = 3 - 4;
let product = 5 * 6;
let quotient = 7 / 8;
let remainder = 9 % 10;

// ---- Comparison -----------------------------------------------------------
// Non-associative (§expressions): `a < b < c` is a parse error rather than a
// type error, because a parse error names the actual mistake. So each of these
// holds exactly one comparison.

let equal = 1 == 2;
let unequal = 1 != 2;
let less = 1 < 2;
let at_most = 1 <= 2;
let greater = 1 > 2;
let at_least = 1 >= 2;
// The rewrite the diagnostic suggests for a chain.
let between = 0 < n && n < 10;

// ---- Logical --------------------------------------------------------------
// `bool` only, short-circuiting — which makes them control flow wearing an
// operator's clothes (§expressions).

let both = true && false;
let either = true || false;

// ---- Conversion -----------------------------------------------------------
// `as` is explicit and trapping, deliberately unlike Rust's, which truncates
// silently. Lossy conversions exist but have names (§expressions).

let narrowed = 300 as u32;
let to_float = 300 as f64;
let to_int = 1.5 as s64;

// ---- Postfix --------------------------------------------------------------

let called = nothing_at_all();
let with_args = f(1, 2);
let trailing_comma = f(1, 2,);
let indexed = items[0];
let field = point.x;
// A method call is `.name(…)`, with the parens (§expressions).
let method = counter.next();
let chained = lookup(1).result[0].value;

// ---- Struct literals ------------------------------------------------------

struct Point {
  x: s64,
  y: s64,
}

struct Line {
  from: Point,
  to: Point,
}

struct Empty { }

struct Row {
  result: Str,
}

let origin = Point { x: 0, y: 0 };
let nested = Line { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 } };
let no_fields = Empty { };

// ---- Block expressions ----------------------------------------------------
// A block's value is its trailing expression, written without a `;`. A `;`
// discards (§expressions).

let from_block = {
  let t = f(1, 2);
  t * 2
};
// Yields unit: the `;` discarded the 42.
let discarded = { f(1, 2); 42; };

// ---- Conditionals ---------------------------------------------------------
// `if` is an expression (§expressions). Braces are mandatory and the condition
// is unparenthesized (§control), which together delete the dangling-else
// problem.

let branch = if ok { 42 } else { 0 };
// `else if` is `else` followed by another `if`, not a keyword of its own.
let chain = if ok { 1 } else if ready { 2 } else { 3 };

// ---- Lambdas --------------------------------------------------------------
// `(params) -> body`. Parameter and return types come from context, unlike a
// `fn`: a declaration is read by others, a lambda is read in place
// (§functions).
//
// The parameter list is spelled exactly like a parenthesized expression, so
// the `->` after the `)` is the only thing that tells the two apart — which is
// the one place the grammar needs to look past a closing bracket to decide.

let typed = (x: u64) -> x + 1;
let inferred: fn(u64) -> u64 = (x) -> x + 1;
let several = (x: u64, y: u64) -> x + y;
let nullary = () -> work();
let with_block: fn(u64) -> u64 = (x) -> {
  let y = x * 2;
  y + 1
};

// ---- Precedence -----------------------------------------------------------
// Tightest to loosest, each line pinned against the one below it. The comment
// beside each is the grouping §expressions' table gives it. §lexical has no
// promotion, so the operands are chosen to have one type each rather than to
// read prettily.

let a = 9u64;
let b = 3u64;
let c = 2u64;
let narrow = 3u8;

let l1 = -point.x;             // (-(point.x))           postfix over unary
let l2 = -point.x as s8;       // ((-point.x) as s8)     unary over `as`
let l3 = a as u8 * narrow;     // ((a as u8) * narrow)   `as` over `*`
let l4 = a + b * c;            // (a + (b * c))          `*` over `+`
let l5 = a + b == c;           // ((a + b) == c)         `+` over comparison
let l6 = ok && b == c;         // (ok && (b == c))       comparison over `&&`
let l7 = ok || ready && ok;    // (ok || (ready && ok))  `&&` over `||`

// §comptime's prefix — "this must be evaluated during compilation" — takes the
// same rung as `-` and `!`. So it covers a call, which is the only form
// §comptime ever writes, and stops short of a sum, which is spelled
// `comptime (a + b)` when that is what is meant. Choosing an existing rung is
// what makes this no new rule; §comptime does not settle it either way.
//
// It elaborates to "comptime is not supported yet". The token exists so these
// programs have a settled shape and the language server has something to
// colour; `Type`, the instantiation cache, and the second evaluator
// configuration do not exist yet. See `generics.glue`.
let l8 = comptime f(1, 2);     // (comptime (f 1 2))     postfix over comptime
let l9 = comptime a + b;       // ((comptime a) + b)     comptime over `+`

// Every binary operator is left-associative.
let leans_left = a - b - c;    // ((a - b) - c)

// A file may end in an expression with no `;` (§statements).
sum + difference
