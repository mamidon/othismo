# The runtime's own header, `env`: the message types the runtime and its
# built-in objects use, the conventional bodies for the verbs, and the
# built-in objects themselves.
#
# Its types are always in scope in an image. A header imports them with
# `import { ... } from env`, and AssemblyScript with
# `import { ... } from "othismo/env"`, whose bindings are generated from
# this file. The runtime embeds it.

# ---------------------------------------------------------------------------
# Conventional bodies

## A string value: a setting, an address, a name.
message Text {
  text: string
}

## The contents of something, as `read` answers.
message Data {
  ## Its MIME type, or "" if it isn't known.
  mime: string
  data: bytes
}

## What `stat` answers.
message Info {
  ## "file" or "dir".
  kind: string
  ## In bytes; 0 for a directory.
  size: i64
  ## Its MIME type, or "" if it isn't known.
  mime: string
}

## One name in a `list` stream, or what `create` made.
message Entry {
  name: string
  ## "file" or "dir".
  kind: string
}

# ---------------------------------------------------------------------------
# Environment.Console

## One line of text, without its line ending.
message Line {
  text: string
}

## The console: the host's stdin and stdout.
##
## Whatever is written to it is printed on a line of its own. A message whose
## only field is a string `text`, such as a `Line`, prints as that text; any
## other as its type and fields.
object Environment.Console {
  serves {
    ## Watch for every line of stdin, until it ends; write to print.
    /   watch -> Line*, write Opaque
  }
}

# ---------------------------------------------------------------------------
# Environment.Tcp

## Configures a Tcp listener.
message Listen {
  ## The address to listen on, e.g. "127.0.0.1:8080".
  address: string
}

## A new connection.
message Accepted {
  ## Its name under the listener: watch, write or remove `/<conn>`.
  conn: string
  ## The remote address.
  peer: string
}

## A TCP listener, on the address the image configures it with.
object Environment.Tcp {
  serves {
    ## Configured by the image only.
    /           control Listen
    ## The bound address, e.g. "127.0.0.1:8080".
    /address    read -> Text
    ## Every connection accepted, as it is.
    /accept     watch -> Accepted*
    ## A connection: watch for the bytes received, until the peer closes;
    ## write to send; remove to close our side once everything is sent.
    /{conn}     watch -> Data*, write Data, remove
  }
}

# ---------------------------------------------------------------------------
# Environment.Files

## Configures Files.
message FilesRoot {
  ## The directory served, relative to the image.
  path: string
}

## Read-only access to one directory on the host, and nothing above it.
##
## A file's MIME type comes from its extension. Reading a directory answers
## `is_directory`, and a listing is sorted by name.
object Environment.Files {
  serves {
    ## Configured by the image only.
    /     control FilesRoot, read -> Data, stat -> Info, list -> Entry*
    /**   read -> Data, stat -> Info, list -> Entry*
  }
}

## Files packed into the image when it was built, by its `include`s. It
## answers as `Environment.Files` does.
object Packed.Files {
  serves {
    /**   read -> Data, stat -> Info, list -> Entry*
  }
}
