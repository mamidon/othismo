## A console: lines in, and anything out. The runtime runs it on the host's
## stdin and stdout.
##
## Whatever is written to it is printed on a line of its own: text as it
## is, a stat record as its fields, and anything else as its content type
## and length.
export trait Console {
  ## Watch for every line of input, until it ends; write to print.
  /   watch -> text/plain*, write */*
}

## The other side of a console in memory: type lines into it, and watch
## what it prints.
export trait Terminal {
  ## Type a line, as if on stdin.
  /typed     write text/plain
  ## Everything written to the console, as it is written.
  /printed   watch -> */**
}

## A console in memory, which touches nothing on the host, to give an image
## where it would be given the real one.
export object MemoryConsole : Console, Terminal {}
