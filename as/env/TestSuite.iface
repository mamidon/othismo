## How a test went.
message Outcome {
  passed: bool
  ## Why it failed, or anything worth saying about it.
  detail: string
}

## Something with tests to run, which `othismo test` finds by this trait and
## runs, each in a fresh run of the image.
trait TestSuite {
  ## The tests, by name.
  /tests          list
  ## Runs a test, and answers how it went, as an `Outcome`.
  /tests/{name}   invoke -> application/bson
}
