import { File, Dir } from "./bodies.iface"

## Configures Files.
message FilesRoot {
  ## The directory served, relative to the image.
  path: string
}

## Read-only access to one directory on the host, and nothing above it.
##
## A file's content type comes from its extension. Reading a directory
## answers `is_directory`, and a listing is sorted by name.
trait Files {
  ## Configured by the image only, with a `FilesRoot`.
  /     control application/bson, File, Dir
  /**   File, Dir
}
