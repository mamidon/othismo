# Holds a record of each of the BSON format's field types; types.test.oth
# tests them.

import { Record, Store } from "./scripts/Store.oth"

instance store : Store

mount /store store
write /store/record Record {
  name: "start",
  count: 7,
  owner: { name: "Ada", age: 36 },
  tags: ["a", "b"],
  grid: [[1, 2], [], [-3]],
  team: [{ name: "Bo", age: 1 }],
}
