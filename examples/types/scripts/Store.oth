## Keeps the last `Record` written to it, to read back: a payload of each of
## the BSON format's field types, sent and received.
export object Store {
  serves {
    ## The last record written.
    /record  write Record, read -> Record
  }
}

export schemas application/bson {
  ## A field of each type.
  message Record {
    name: string
    count: i32
    ## A moment, and an id.
    born: time
    id: uuid
    ## Another message.
    owner: Person
    ## Lists, of anything a field can be.
    tags: [string]
    grid: [[i32]]
    team: [Person]
    ## Maps, from strings to anything a field can be.
    env: {string}
    teams: {[Person]}
    ## Optional fields, which a record may leave out.
    nick?: string
    rank?: i32
    boss?: Person
  }

  ## Someone.
  message Person {
    name: string
    age: u8
  }
}
