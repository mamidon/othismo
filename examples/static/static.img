# A static file server. It touches the host in only two ways: one TCP
# listener, and the console for the access log. The site's files are packed
# into the image when it is built.

# Where to listen. Deploy with e.g. `--set listen.address=0.0.0.0:80`.
require listen : Listen { address: "127.0.0.1:8080" }

# HTTP in, namespace requests out. It reaches the files only through the site.
instance http : HttpServer {
  mount /net/tcp net
  mount /www site
  mount /dev/cons cons
}

# The site can read the files and nothing else.
instance site : StaticSite {
  mount /files files readonly
}

instance net   : Environment.Tcp
instance cons  : Environment.Console
instance files : Packed.Files { include "./public/" }

# What the image itself can reach, to configure it.
mount /net  net
mount /http http

control /net listen
control /http/hosts/* Text { text: "/www" }
control /http/hosts/files.localhost Text { text: "/www/static" }
