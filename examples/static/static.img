// A static file server. The only capabilities it has are the two below:
// one TCP listener on 127.0.0.1:8080 and read-only access to ./public.
import { Line, Listen, Listening, SocketData, SocketClosed, SocketWrite, SocketClose,
         FilesRoot, ReadFile, FileContents, FileError } from "real-talk/env"
import { HttpRequest, HttpResponse } from "./messages"

// Bytes <-> typed HTTP messages.
protocol HttpCodec {
  in SocketData, SocketClosed, HttpResponse
  emits HttpRequest
  replies SocketWrite, SocketClose
}

// Typed HTTP requests -> file reads -> typed HTTP responses.
protocol StaticServer {
  in HttpRequest, FileContents, FileError
  emits ReadFile, Line
  replies HttpResponse
}

instance net    : Environment.Socket { send Listen { address: "127.0.0.1:8080" } }
instance http   : HttpCodec
instance server : StaticServer
instance files  : Environment.Files { send FilesRoot { path: "./public" } }
instance stdout : Environment.Stdout

// Requests flow down this tree; every response is a reply back up it.
net.SocketData {
  http.HttpRequest {
    server.ReadFile { files }
    server.Line     { stdout }
  }
}
net.SocketClosed { http }
net.Listening    { stdout }
