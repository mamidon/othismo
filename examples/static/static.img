// A static file server. The only capabilities in it are the three below: one
// TCP listener on 127.0.0.1:8080, read-only access to ./public, and the
// console for the access log.
instance net   : Environment.Tcp     { send Listen    { address: "127.0.0.1:8080" } }
instance files : Environment.Files   { send FilesRoot { path: "./public" } }
instance cons  : Environment.Console

// The site can read the files and nothing else.
instance site : StaticSite {
  mount files /files readonly
}

// HTTP in, namespace requests out. It reaches the files only through the site.
instance http : HttpServer {
  mount net  /net/tcp
  mount site /www
  mount cons /dev/cons
  write /hosts/* Text { text: "/www" }
  write /hosts/files.localhost Text { text: "/www/static" }
}
