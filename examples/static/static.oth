# Serves the site on the host. Everything this program can do to the
# machine it runs on is in its needs: one TCP listener, and the console.

import Site from "./site.oth"
import { Console, Listener } from env

# Where to listen. Deploy with e.g. `--set listen=0.0.0.0:80`.
require listen : text/plain = "127.0.0.1:8080"

needs Listener at /net/tcp
needs Console  at /dev/cons

instance web of Site {
  bind /net/tcp
  bind /dev/cons
}

write /net/tcp listen
