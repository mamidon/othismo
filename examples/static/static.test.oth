# The site's tests. It runs as site.oth declares it, but given a listener
# and a console in memory: nothing touches the host. SiteTests dials the
# listener with each test's request. Run them with
# `othismo test static.test.oth`.

import Site from "./site.oth"
import { SiteTests } from "./scripts/SiteTests.oth"
import { MemoryConsole, MemoryListener } from env

instance net  of MemoryListener
instance cons of MemoryConsole

instance web of Site {
  mount /net/tcp  from net
  mount /dev/cons from cons
}

instance tests of SiteTests {
  mount /net from net
}
