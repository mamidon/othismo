// Greets each name typed on stdin, shouts the greeting back, and reports
// running statistics. Exercises startup sends, multiple `in` types,
// multiple out ports and fan-out.
import { Line, Greeting, Stats } from "./messages"

protocol Greeter {
  in Line, Greeting
  out greeted: Line
  out stats: Stats
}

protocol Shouter {
  in Line
  out out: Line
}

instance stdin : Environment.Stdin {
  out -> greeter
}

instance greeter : Greeter {
  send Greeting { prefix: "Hello, ", excited: true }
  greeted -> stdout, shouter
  stats -> stdout
}

instance shouter : Shouter {
  out -> stdout
}

instance stdout : Environment.Stdout
