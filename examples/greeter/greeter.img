// Greets each name typed on stdin, shouts the greeting back, and reports
// running statistics. Exercises a startup send, multiple `in` types,
// fan-out and nested routes.
import { Line } from "real-talk/env"
import { Greeting, Stats } from "./messages"

protocol Greeter {
  in Line, Greeting
  emits Line, Stats
}

protocol Shouter {
  in Line
  emits Line
}

instance stdin : Environment.Stdin

instance greeter : Greeter {
  send Greeting { prefix: "Hello, ", excited: true }
}

instance shouter : Shouter
instance stdout  : Environment.Stdout

stdin.Line {
  greeter.Line {
    stdout
    shouter.Line { stdout }
  }
  greeter.Stats { stdout }
}
